---
import {
	getEmDashCollection,
	getMenuWithCacheHint,
	getSiteSettingsWithCacheHint,
} from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const [settingsResult, menuResult, pagesResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getEmDashCollection("pages"),
]);
Astro.cache.set(settingsResult.cacheHint);
Astro.cache.set(menuResult.cacheHint);
Astro.cache.set(pagesResult.cacheHint);
const { siteTitle, siteFavicon } = resolveBlogSiteIdentity(settingsResult.data);
const menu = menuResult.data;
const pages = pagesResult.entries;
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		{siteFavicon && <link rel="icon" href={siteFavicon} />}
		<EmDashHead page={pageCtx} />
		<script is:inline>
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				} else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<div class="site-header__inner">
				<a href="/" class="site-title">mopeneko</a>
				<div class="nav-right">
					<nav class="nav-links" aria-label="メインナビゲーション">
						{menu?.items.map((item) => (
							<a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>{item.label}</a>
						))}
					</nav>
					<LiveSearch
						placeholder="記事・ページを検索..."
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["posts", "pages"]}
					/>
					<button type="button" class="header-theme" aria-label="テーマを切り替える" title="テーマを切り替える">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
					</button>
					{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
				</div>
			</div>
		</header>

		<main><slot /></main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-main">
					<div class="footer-brand">
						<a href="/" class="footer-domain">blog.lem0n.cc</a>
						<p>Powered by <a href="https://emdashcms.com">EmDash</a> and <a href="https://astro.build">Astro</a></p>
					</div>
					<nav class="footer-links" aria-label="フッターナビゲーション">
						<a href="/posts">すべての記事</a>
						{pages.map((page) => <a href={`/pages/${page.data.slug || page.id}`}>{page.data.title}</a>)}
						{menu?.items.map((item) => <a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>{item.label}</a>)}
						<a href="/rss.xml">RSS</a>
					</nav>
				</div>
				<div class="footer-widgets"><WidgetArea name="footer" /></div>
				<div class="footer-bottom">
					<span>mopeneko</span>
					<div class="theme-switcher" aria-label="表示テーマ">
						<button type="button" class="theme-btn" data-theme="light" aria-label="ライトモード">Light</button>
						<button type="button" class="theme-btn" data-theme="dark" aria-label="ダークモード">Dark</button>
						<button type="button" class="theme-btn" data-theme="system" aria-label="システムテーマ">System</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			const THEME_REGEX = /theme=([^;]+)/;
			const themeBtns = document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(name: string, value: string, maxAge = 31536000) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				document.cookie = value === ""
					? `${name}=; path=/; max-age=0; SameSite=Lax${secure}`
					: `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) root.classList.add("dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				return document.cookie.match(THEME_REGEX)?.[1] || "system";
			}

			setTheme(getStoredTheme());
			const headerTheme = document.querySelector<HTMLButtonElement>(".header-theme");
			headerTheme?.addEventListener("click", () => {
				const themes = ["light", "dark", "system"];
				const next = (themes.indexOf(getStoredTheme()) + 1) % themes.length;
				setTheme(themes[next]);
			});
			themeBtns.forEach((btn) => btn.addEventListener("click", () => setTheme(btn.dataset.theme || "system")));
			window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
				if (getStoredTheme() === "system") root.classList.toggle("dark", event.matches);
			});
		</script>

		<style is:global>
			@layer base;
			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after { box-sizing: border-box; }
				body, h1, h2, h3, h4, h5, h6, p, ul, ol, figure, blockquote, dl, dd { margin: 0; }
				ul, ol { padding: 0; }
				:root {
					--font-size-xs: 0.8125rem;
					--font-size-sm: 0.875rem;
					--font-size-base: 1rem;
					--font-size-lg: 1.125rem;
					--font-size-xl: 1.25rem;
					--font-size-2xl: 1.5rem;
					--font-size-3xl: 2rem;
					--font-size-4xl: 2.5rem;
					--font-size-5xl: 3.5rem;
					--leading-tight: 1.15;
					--leading-snug: 1.3;
					--leading-normal: 1.5;
					--spacing-1: 0.25rem;
					--spacing-2: 0.5rem;
					--spacing-3: 0.75rem;
					--spacing-4: 1rem;
					--spacing-5: 1.25rem;
					--spacing-6: 1.5rem;
					--spacing-8: 2rem;
					--spacing-10: 2.5rem;
					--spacing-12: 3rem;
					--spacing-16: 4rem;
					--spacing-20: 5rem;
					--spacing-24: 6rem;
					--tracking-tight: -0.03em;
					--tracking-snug: -0.02em;
					--tracking-wide: 0.06em;
					--tracking-wider: 0.08em;
					--shadow-dropdown: 0 8px 30px rgba(0, 0, 0, 0.12);
					--shadow-btn-active: 0 1px 2px rgba(0, 0, 0, 0.05);
					--emdash-search-bg: var(--color-bg);
					--emdash-search-text: var(--color-text);
					--emdash-search-muted: var(--color-muted);
					--emdash-search-border: var(--color-border);
					--emdash-search-hover: var(--color-bg-subtle);
					--emdash-search-highlight: var(--color-text);
				}
				html { scroll-behavior: smooth; }
				body {
					min-height: 100vh;
					background: var(--color-bg);
					color: var(--color-text);
					font-family: var(--font-sans);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					letter-spacing: 0.018em;
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
				}
				a:where(:not([class*="emdash"]):not([class*="ec-"])) { color: var(--color-accent); text-decoration: none; transition: color var(--transition-fast); }
				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover { color: var(--color-accent-hover); }
				img { display: block; max-width: 100%; height: auto; }
				h1, h2, h3, h4, h5, h6 { font-family: var(--font-sans); font-weight: 600; line-height: var(--leading-tight); letter-spacing: var(--tracking-snug); }
				h1 { font-weight: 700; letter-spacing: var(--tracking-tight); }
				::selection { background: var(--color-accent); color: var(--color-on-accent); }
			}
		</style>

		<style>
			.site-header { position: relative; z-index: 100; border-bottom: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-bg) 92%, transparent); backdrop-filter: blur(8px); }
			.site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: var(--wide-width); height: var(--nav-height); margin: 0 auto; padding: 0 24px; }
			.site-title { flex: none; color: var(--color-text); font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
			.site-title:hover { color: var(--color-text); }
			.nav-right, .nav-links { display: flex; align-items: center; gap: 6px; }
			.nav-right { gap: 10px; min-width: 0; }
			.nav-links a { padding: 6px 12px; border-radius: var(--radius); color: var(--color-muted); font-size: 13px; white-space: nowrap; }
			.nav-links a:hover { background: var(--color-bg-subtle); color: var(--color-text); }
			.nav-admin { color: var(--color-muted); font-size: 12px; }
			.site-search { position: relative; width: var(--search-input-width); --emdash-search-border-focus: var(--color-accent); }
			:global(.site-search-input) { width: 100%; height: 36px; padding: 0 12px; border: 1px solid var(--color-border-strong); border-radius: var(--radius); background: transparent; color: var(--color-text); font-family: var(--font-sans); font-size: 12px; }
			:global(.site-search-input)::placeholder { color: var(--color-muted); }
			:global(.site-search-input):focus { outline: none; border-color: var(--color-accent) !important; box-shadow: 0 0 0 3px var(--color-accent-ring); }
			:global(.site-search-results) { position: absolute; top: 100%; right: 0; left: 0; z-index: 1000; max-height: 400px; margin-top: 8px; overflow-y: auto; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg); box-shadow: var(--shadow-dropdown); }
			:global(.site-search-results .emdash-live-search-loading), :global(.site-search-results .emdash-live-search-no-results) { padding: 16px; color: var(--color-muted); font-size: 13px; text-align: center; }
			:global(.site-search-result) { display: block; padding: 12px 16px; border-bottom: 1px solid var(--color-border); color: var(--color-text); }
			:global(.site-search-result):last-child { border-bottom: 0; }
			:global(.site-search-result):hover, :global(.site-search-result):focus, :global(.site-search-result.focused) { background: var(--color-bg-subtle); color: var(--color-text); outline: none; }
			:global(.site-search-result .emdash-live-search-result-title) { display: block; font-size: 14px; font-weight: 500; }
			:global(.site-search-result .emdash-live-search-result-collection) { display: block; margin-top: 2px; color: var(--color-muted); font-size: 11px; text-transform: uppercase; }
			:global(.site-search-result .emdash-live-search-result-snippet) { display: block; margin-top: 4px; color: var(--color-muted); font-size: 12px; line-height: 1.5; }
			.header-theme { display: inline-flex; flex: none; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1px solid var(--color-border); border-radius: var(--radius); background: transparent; color: var(--color-muted); cursor: pointer; }
			.header-theme:hover { background: var(--color-bg-subtle); color: var(--color-text); }
			.theme-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 30px; padding: 0 8px; border: 1px solid var(--color-border); border-radius: var(--radius); background: transparent; color: var(--color-muted); cursor: pointer; font: inherit; font-size: 11px; }
			.theme-btn:hover, .theme-btn.active { background: var(--color-bg-subtle); color: var(--color-text); }
			main { min-height: calc(100vh - var(--nav-height) - 220px); }
			.site-footer { border-top: 1px solid var(--color-border); background: var(--color-bg-subtle); color: var(--color-muted); font-size: 12.5px; }
			.footer-inner { max-width: var(--wide-width); margin: 0 auto; padding: 40px 24px 24px; }
			.footer-main { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 20px 36px; }
			.footer-brand p { margin-top: 4px; }
			.footer-brand p a { color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 2px; }
			.footer-domain { color: var(--color-text); font-family: var(--font-mono); font-size: 14px; font-weight: 500; }
			.footer-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 20px; }
			.footer-links a { color: var(--color-muted); }
			.footer-links a:hover { color: var(--color-text); }
			.footer-widgets:not(:empty) { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--color-border); }
			.footer-widgets :global(.widget-area) { display: flex; flex-wrap: wrap; gap: 24px; }
			.footer-widgets :global(.widget__title) { margin-bottom: 8px; color: var(--color-text-secondary); font-size: 12px; }
			.footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--color-border); font-family: var(--font-mono); font-size: 11px; }
			.theme-switcher { display: flex; gap: 4px; }
			@media (max-width: 860px) {
				.site-header__inner { height: auto; min-height: var(--nav-height); flex-wrap: wrap; padding-top: 10px; padding-bottom: 10px; }
				.nav-right { flex-wrap: wrap; justify-content: flex-end; }
				.nav-links { order: 3; width: 100%; }
			}
			@media (max-width: 680px) {
				.site-header__inner { align-items: flex-start; gap: 8px; padding: 10px 16px; }
				.nav-right { flex: 1; }
				.site-search { width: min(210px, 100%); flex: 1; }
				.nav-links { justify-content: flex-start; overflow-x: auto; }
				.nav-links a { padding-right: 8px; padding-left: 0; }
				.footer-inner { padding: 32px 20px 20px; }
				.footer-links { justify-content: flex-start; }
			}
		</style>

		<script>
			document.addEventListener("keydown", (event) => {
				if ((event.metaKey || event.ctrlKey) && event.key === "k") {
					event.preventDefault();
					document.querySelector<HTMLInputElement>(".site-search-input")?.focus();
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

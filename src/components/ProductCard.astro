---
import type { InferCollectionData } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	product: InferCollectionData<"products">;
}

interface ProductLink {
	label: string;
	url: string;
}

function isProductLink(value: unknown): value is ProductLink {
	if (!value || typeof value !== "object") return false;
	const link = value as Record<string, unknown>;
	return typeof link.label === "string" && typeof link.url === "string";
}

const { product } = Astro.props;
const links = Array.isArray(product.links) ? product.links.filter(isProductLink) : [];
---

<section class="product-card">
	<span class="product-card__label">スポンサーリンク</span>
	<div class="product-card__body">
		{product.image && (
			<div class="product-card__image"><Image image={product.image} /></div>
		)}
		<div class="product-card__main">
			{product.maker && <p class="product-card__maker">{product.maker}</p>}
			<h2 class="product-card__title">{product.title}</h2>
			{links.length > 0 && (
				<div class="product-card__links">
					{links.map((link, index) => (
						<a
							href={link.url}
							target="_blank"
							rel="sponsored noopener"
							class:list={["product-card__link", { "product-card__link--sub": index > 0 }]}
						>{link.label}</a>
					))}
				</div>
			)}
		</div>
	</div>
</section>

<style>
	.product-card {
		margin: 40px 0;
	}

	.product-card__label {
		display: block;
		margin-bottom: 6px;
		color: var(--color-muted);
		font-size: 11px;
	}

	.product-card__body {
		display: flex;
		align-items: center;
		gap: 20px;
		padding: 20px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.product-card__image {
		flex: 0 0 112px;
		width: 112px;
		height: 84px;
		padding: 4px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: #fff;
	}

	.product-card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.product-card__main {
		min-width: 0;
	}

	.product-card__maker {
		margin-bottom: 4px;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 11px;
	}

	.product-card__title {
		margin-bottom: 10px;
		font-size: 17px;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.product-card__links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.product-card__link {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		padding: 8px 14px;
		border: 1px solid var(--color-accent);
		border-radius: var(--radius);
		background: var(--color-accent);
		color: #fff;
		font-size: 12.5px;
		font-weight: 500;
		line-height: 1.2;
		overflow-wrap: anywhere;
		text-decoration: none;
	}

	:global(.dark) .product-card__link {
		color: #141210;
	}

	.product-card__link--sub {
		border-color: var(--color-border-strong);
		background: var(--color-bg-subtle);
		color: var(--color-text);
	}

	:global(.dark) .product-card__link--sub {
		color: var(--color-text);
	}

	.product-card__link:hover {
		opacity: 0.88;
	}

	@media (max-width: 600px) {
		.product-card__body {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>

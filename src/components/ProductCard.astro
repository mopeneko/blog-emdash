---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface ProductLink {
	label: string;
	url: string;
}

interface Props {
	product: {
		data: {
			title: string;
			maker?: string;
			image?: MediaValue | string;
			links?: ProductLink[];
		};
	};
}

const { product } = Astro.props;
const { title, maker, image, links = [] } = product.data;
---

<section class="product-card">
	<span class="product-card__label">スポンサーリンク</span>
	<div class="product-card__body">
		{image && (
			<div class="product-card__image">
				<Image image={image} />
			</div>
		)}
		<div class="product-card__main">
			<div class="product-card__text">
				<h2 class="product-card__title">{title}</h2>
				{maker && <span class="product-card__maker">メーカー: {maker}</span>}
			</div>
			{links.length > 0 && (
				<div class="product-card__buttons">
					{links.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="sponsored noopener"
							class="product-card__button"
						>
							{link.label}
						</a>
					))}
				</div>
			)}
		</div>
	</div>
</section>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		margin: var(--spacing-10) 0;
	}

	.product-card__label {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.product-card__body {
		display: flex;
		align-items: center;
		gap: var(--spacing-5);
		padding: var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
	}

	.product-card__image {
		flex: 0 0 auto;
		width: 128px;
		height: 128px;
		border-radius: var(--radius);
		overflow: hidden;
	}

	.product-card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product-card__main {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		flex: 1;
		min-width: 0;
	}

	.product-card__text {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}

	.product-card__title {
		font-size: var(--font-size-xl);
		font-weight: 600;
		margin: 0;
	}

	.product-card__maker {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.product-card__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.product-card__button {
		display: inline-block;
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-on-accent);
		background: var(--color-accent);
		border-radius: var(--radius);
		text-decoration: none;
		transition: opacity var(--transition-fast);
	}

	.product-card__button:hover {
		opacity: 0.85;
	}

	@media (max-width: 600px) {
		.product-card__body {
			flex-direction: column;
			align-items: stretch;
		}

		.product-card__image {
			width: 100%;
			height: auto;
			aspect-ratio: 1;
			max-width: 200px;
			margin: 0 auto;
		}
	}
</style>

---
import { getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { toPostCardProps } from "../utils/post-presentation";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { getSiteSettings } from "emdash";

const postsResult = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
Astro.cache.set(postsResult.cacheHint);
const posts = postsResult.entries;
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());
const cards = await Promise.all(
	posts.map(async (post) => toPostCardProps(
		post.data,
		`/posts/${post.id}`,
		await getEntryTerms("posts", post.data.id, "tag"),
	)),
);
---

<Base title={siteTitle} description={siteTagline}>
	<section class="index-hero">
		<div class="index-hero__inner">
			<div>
				<p class="index-hero__eyebrow">JAPANESE TECHNICAL &amp; CRAFT WEBLOG</p>
				<h1>思考と実装の記録を、静かに積み上げる</h1>
				<p>Linux・NixOS・Astro・AIエージェント開発の検証ログから、オーディオ機器の長期レビューまで。</p>
			</div>
			<div class="index-hero__stats" aria-label="ブログ統計">
				<span><strong>{posts.length}</strong>公開記事</span>
			</div>
		</div>
	</section>

	<div class="index-body">
		<section class="article-stream" aria-labelledby="recent-articles">
			<header><h2 id="recent-articles">RECENT ARTICLES</h2><span>{cards.length} 記事</span></header>
			{cards.length > 0
				? cards.map((card) => <PostCard {...card} />)
				: <p class="empty">まだ記事がありません。</p>}
		</section>
	</div>
</Base>

<style>
	.index-hero { padding: 40px 24px; border-bottom: 1px solid var(--color-border); background: var(--color-bg-subtle); }
	.index-hero__inner { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; max-width: var(--wide-width); margin: 0 auto; }
	.index-hero__inner > div:first-child { min-width: 0; }
	.index-hero__eyebrow { margin-bottom: 6px; color: var(--color-accent); font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; }
	.index-hero h1 { margin-bottom: 6px; font-size: 26px; font-weight: 600; line-height: 1.45; letter-spacing: -0.015em; }
	.index-hero__inner > div:first-child > p:last-child { color: var(--color-text-secondary); font-size: 14px; line-height: 1.75; }
	.index-hero__stats { display: flex; gap: 20px; padding-left: 16px; border-left: 2px solid var(--color-border-strong); color: var(--color-text-secondary); font-family: var(--font-mono); font-size: 11px; }
	.index-hero__stats strong { display: block; color: var(--color-text); font-size: 16px; }
	.index-body { max-width: var(--wide-width); margin: 0 auto; padding: 36px 24px 72px; }
	.article-stream { min-width: 0; }
	.article-stream > header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 4px; padding-bottom: 10px; border-bottom: 1px solid var(--color-border); color: var(--color-muted); font-family: var(--font-mono); font-size: 12px; }
	.article-stream > header h2 { font: inherit; letter-spacing: 0.04em; }
	.empty { padding: 24px 0; color: var(--color-muted); }
	@media (max-width: 680px) {
		.index-hero { padding: 32px 20px; }
		.index-hero h1 { font-size: 23px; }
		.index-body { padding: 28px 20px 56px; }
	}
</style>

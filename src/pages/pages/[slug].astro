---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");
const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.redirect("/404");
Astro.cache.set(cacheHint);
---

<Base title={page.data.title} content={{ collection: "pages", id: page.data.id, slug }}>
	<article class="page-article">
		<header class="page-header"><h1 class="page-title" {...page.edit.title}>{page.data.title}</h1></header>
		<div class="page-content"><PortableText value={page.data.content} /></div>
	</article>
</Base>

<style>
	.page-article { max-width: 788px; margin: 0 auto; padding: 48px 24px 80px; }
	.page-header { margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
	.page-header h1 { font-size: 30px; line-height: 1.38; overflow-wrap: anywhere; }
	.page-content { min-width: 0; font-size: 16px; line-height: 1.95; }
	.page-content :global(p) { margin-bottom: 22px; }
	.page-content :global(h2) { margin: 44px 0 18px; padding-bottom: 8px; border-bottom: 1px solid var(--color-border); font-size: 22px; line-height: 1.4; }
	.page-content :global(h3) { margin: 30px 0 12px; font-size: 18px; }
	.page-content :global(blockquote) { margin: 28px 0; padding: 16px 20px; border-left: 3px solid var(--color-accent); background: var(--color-bg-subtle); color: var(--color-text-secondary); }
	.page-content :global(ul), .page-content :global(ol) { margin-bottom: 22px; padding-left: 22px; }
	.page-content :global(li) { margin-bottom: 8px; }
	.page-content :global(a) { color: var(--color-accent); border-bottom: 1px dotted var(--color-accent); overflow-wrap: anywhere; }
	.page-content :global(img) { margin: 28px 0; border-radius: var(--radius-lg); }
	.page-content :global(code:not(pre code)) { padding: 2px 6px; border-radius: var(--radius); background: var(--inline-code-bg); color: var(--inline-code-fg); font-family: var(--font-mono); font-size: 0.88em; }
	.page-content :global(.emdash-code) { margin: 24px 0 28px; overflow: hidden; border: 1px solid var(--code-border); border-radius: var(--radius-lg); background: var(--code-bg); }
	.page-content :global(.emdash-code-filename) { padding: 8px 14px; border-radius: 0; background: var(--code-header); color: var(--code-fg); font-family: var(--font-mono); font-size: 12px; }
	.page-content :global(.emdash-code pre) { margin: 0; padding: 16px; overflow-x: auto; border-radius: 0; background: var(--code-bg); font-family: var(--font-mono); font-size: 13.5px; }
	.page-content :global(.emdash-code pre code) { padding: 0; background: transparent; color: var(--code-fg); font-family: var(--font-mono); font-size: inherit; }
	@media (max-width: 680px) { .page-article { padding: 32px 20px 56px; } }
</style>

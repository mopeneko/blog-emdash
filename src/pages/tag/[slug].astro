---
import { getTerm, getEmDashCollection, getEntryTerms, getTaxonomyTermsWithCacheHint, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { toPostCardProps } from "../../utils/post-presentation";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug) : null;
if (!term) return Astro.redirect("/404");
const { cacheHint: taxonomyCacheHint } = await getTaxonomyTermsWithCacheHint("tag", { includeCounts: false });
Astro.cache.set(taxonomyCacheHint);
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});
Astro.cache.set(cacheHint);
const cards = await Promise.all(
	posts.map(async (post) => toPostCardProps(
		post.data,
		`/posts/${post.id}`,
		await getEntryTerms("posts", post.data.id, "tag"),
	)),
);
---

<Base title={`#${term.label} の記事`} description={`${term.label} タグの記事一覧`}>
	<section class="archive-section">
		<header class="archive-header">
			<p class="archive-label">TAG</p>
			<h1 class="archive-title">#{term.label}</h1>
			<p class="archive-count">{cards.length} 記事</p>
		</header>
		<div class="article-stream">
			{cards.length > 0
				? cards.map((card) => <PostCard {...card} />)
				: <p class="empty">このタグの記事はまだありません。</p>}
		</div>
	</section>
</Base>

<style>
	.archive-section { max-width: 900px; margin: 0 auto; padding: 48px 24px 80px; }
	.archive-header { margin-bottom: 8px; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
	.archive-label { margin-bottom: 8px; color: var(--color-accent); font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; }
	.archive-header h1 { font-size: 1.875rem; overflow-wrap: anywhere; }
	.archive-count { margin-top: 8px; color: var(--color-muted); font-size: 0.8125rem; }
	.empty { padding: 24px 0; color: var(--color-muted); }
	@media (max-width: 680px) { .archive-section { padding: 32px 20px 56px; } }
</style>

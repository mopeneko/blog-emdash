---
import Base from "../layouts/Base.astro";
---

<Base title="ページが見つかりません">
	<div class="not-found">
		<p>PAGE NOT FOUND</p>
		<h1>404</h1>
		<p>お探しのページは見つかりませんでした。</p>
		<a href="/">記事一覧へ戻る</a>
	</div>
</Base>

<style>
	.not-found { max-width: 740px; margin: 0 auto; padding: 96px 24px; text-align: center; }
	.not-found > p:first-child { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; }
	.not-found h1 { margin: 8px 0 16px; color: var(--color-border-strong); font-family: var(--font-mono); font-size: 4rem; }
	.not-found h1 + p { margin-bottom: 24px; color: var(--color-muted); }
	.not-found a { display: inline-block; padding: 8px 16px; border: 1px solid var(--color-border-strong); border-radius: var(--radius); color: var(--color-text); font-size: 0.8125rem; }
</style>

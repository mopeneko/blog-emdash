---
import {
	decodeSlug,
	getEmDashCollection,
	getEmDashEntry,
	getEntryTerms,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import ProductCard from "../../components/ProductCard.astro";
import TagList from "../../components/TagList.astro";
import YouTube from "../../components/portable-text/YouTube.astro";
import { renderPostMarkdown } from "../../utils/post-markdown";
import {
	formatPostDate,
	getPostTelemetry,
	toPostCardProps,
} from "../../utils/post-presentation";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");
const { entry: post, cacheHint, isPreview, error } = await getEmDashEntry("posts", slug);
const acceptsMarkdown = Astro.request.headers.get("Accept")?.split(",").some((range) => {
	const [type, ...parameters] = range.toLowerCase().split(";");
	if (type?.trim() !== "text/markdown") return false;
	const weight = parameters.find((parameter) => /^\s*q\s*=/.test(parameter));
	const quality = weight === undefined ? 1 : Number(weight.split("=")[1]);
	return quality > 0 && quality <= 1;
});

if (acceptsMarkdown && ["GET", "HEAD"].includes(Astro.request.method) && !isPreview) {
	const headers = new Headers({ Vary: "Accept" });
	if (error) return new Response(null, { status: 500, headers });
	if (!post || post.data.status !== "published") {
		return new Response(null, { status: 404, headers });
	}

	Astro.cache.set(cacheHint);
	headers.set("Content-Type", "text/markdown; charset=utf-8");
	if (Astro.request.method === "HEAD") return new Response(null, { headers });
	return new Response(renderPostMarkdown(post.data.title, post.data.content ?? [], Astro.url), {
		headers,
	});
}

if (!post) return Astro.redirect("/404");
Astro.cache.set(cacheHint);
Astro.response.headers.append("Vary", "Accept");

function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey = typeof meta?.storageKey === "string"
		? meta.storageKey
		: typeof image.id === "string" ? image.id : undefined;
	return storageKey ? `${Astro.url.origin}/_emdash/api/media/file/${storageKey}` : undefined;
}

const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
	defaultOgImage: featuredImageUrl,
});
const telemetry = getPostTelemetry(post.data.content, post.data.excerpt);
const tags = await getEntryTerms("posts", post.data.id, "tag");
const publishedDate = formatPostDate(post.data.publishedAt);
const bylines = post.data.bylines ?? [];

const productResult = post.data.product
	? await getEmDashEntry("products", post.data.product)
	: null;
if (productResult) Astro.cache.set(productResult.cacheHint);
const linkedProduct = productResult?.entry ?? null;

const { entries: recentPosts, cacheHint: recentCacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 4,
});
Astro.cache.set(recentCacheHint);
const relatedCards = await Promise.all(
	recentPosts.filter((entry) => entry.id !== post.id).slice(0, 3).map(async (entry) =>
		toPostCardProps(
			entry.data,
			`/posts/${entry.id}`,
			await getEntryTerms("posts", entry.data.id, "tag"),
		),
	),
);
const portableTextComponents = { type: { youtube: YouTube } };
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="article-shell">
		<a class="back-link" href="/">← 記事一覧へ戻る</a>
		<header class="article-header">
			<div class:list={["article-header-grid", { "has-image": post.data.featured_image }]}>
				<div>
					<div class="writing-telemetry">
						{bylines.map((credit) => <span>{credit.byline.displayName}</span>)}
						{publishedDate && <time datetime={post.data.publishedAt?.toISOString()}>{publishedDate}</time>}
						<span>{telemetry.characterCount.toLocaleString("ja-JP")} 文字</span>
						<span>コード {telemetry.codeBlockCount}断片</span>
						<span>読了 {telemetry.readingMinutes}分</span>
					</div>
					<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>
					{post.data.excerpt && (
						<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
					)}
					<TagList tags={tags} />
				</div>
				{post.data.featured_image && (
					<div class="article-thumb" {...post.edit.featured_image}><Image image={post.data.featured_image} /></div>
				)}
			</div>
		</header>

		<div class="article-layout">
			<article class="article-main">
				<div class="article-content">
					<PortableText value={post.data.content} components={portableTextComponents} />
				</div>
				{linkedProduct && <ProductCard product={linkedProduct.data} />}
				<div class="article-comments">
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</article>
			<aside class="article-sidebar">
				<div class="sidebar-sticky">
					<nav class="toc" aria-label="目次">
						<h2 class="toc-title">目次</h2>
						<div id="toc-content" />
					</nav>
					<div class="sidebar-widgets"><WidgetArea name="sidebar" /></div>
				</div>
			</aside>
		</div>
	</div>

	{relatedCards.length > 0 && (
		<section class="more-posts">
			<div class="more-inner">
				<h2>続けて読む</h2>
				<div>{relatedCards.map((card) => <PostCard {...card} />)}</div>
			</div>
		</section>
	)}

	<script>
		function buildToc() {
			const content = document.querySelector(".article-content");
			const tocContainer = document.getElementById("toc-content");
			if (!content || !tocContainer) return;
			const headings = Array.from(content.querySelectorAll("h2, h3"))
				.filter((heading) => !heading.closest(".product-card, .article-comments"));
			if (headings.length === 0) {
				const toc = document.querySelector<HTMLElement>(".toc");
				if (toc) toc.hidden = true;
				return;
			}
			const list = document.createElement("ul");
			list.className = "toc-list";
			headings.forEach((heading, index) => {
				if (!heading.id) heading.id = `heading-${index}`;
				const item = document.createElement("li");
				item.className = heading.tagName === "H3" ? "toc-item toc-item--nested" : "toc-item";
				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc-link";
				link.textContent = heading.textContent;
				item.appendChild(link);
				list.appendChild(item);
			});
			tocContainer.replaceChildren(list);
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					tocContainer.querySelectorAll(".toc-link").forEach((link) => link.classList.remove("active"));
					tocContainer.querySelector(`a[href="#${entry.target.id}"]`)?.classList.add("active");
				});
			}, { rootMargin: "-80px 0px -80% 0px" });
			headings.forEach((heading) => observer.observe(heading));
		}
		buildToc();
	</script>
</Base>

<style>
	.article-shell { max-width: 1076px; margin: 0 auto; padding: 36px 24px 88px; }
	.back-link { display: inline-flex; margin-bottom: 20px; padding: 6px 0; color: var(--color-muted); font-size: 0.8125rem; }
	.back-link:hover { color: var(--color-text); }
	.article-header { max-width: var(--article-width); margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
	.article-header-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: center; }
	.article-header-grid.has-image { grid-template-columns: minmax(0, 1fr) 220px; }
	.article-header-grid > div { min-width: 0; }
	.writing-telemetry { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-bottom: 14px; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.6875rem; }
	.article-header h1 { margin-bottom: 16px; font-size: 1.875rem; font-weight: 600; line-height: 1.38; overflow-wrap: anywhere; }
	.article-excerpt { margin-bottom: 16px; color: var(--color-text-secondary); font-size: 0.9375rem; line-height: 1.8; }
	.article-thumb { width: 100%; aspect-ratio: 3 / 2; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-subtle); }
	.article-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.article-layout { display: grid; grid-template-columns: minmax(0, 740px) 240px; gap: 48px; align-items: start; }
	.article-content { min-width: 0; font-size: 1rem; line-height: 1.95; }
	.article-content :global(p) { margin-bottom: 22px; overflow-wrap: anywhere; text-wrap: pretty; }
	.article-content :global(h2) { margin: 44px 0 18px; padding-bottom: 8px; border-bottom: 1px solid var(--color-border); font-size: 1.375rem; font-weight: 700; line-height: 1.4; scroll-margin-top: calc(var(--nav-height) + 16px); }
	.article-content :global(h3) { margin: 30px 0 12px; font-size: 1.125rem; scroll-margin-top: calc(var(--nav-height) + 16px); }
	.article-content :global(ul), .article-content :global(ol) { margin-bottom: 22px; padding-left: 22px; }
	.article-content :global(li) { margin-bottom: 8px; }
	.article-content :global(p a), .article-content :global(li a) { color: var(--color-accent); border-bottom: 1px dotted var(--color-accent); font-weight: 500; overflow-wrap: anywhere; }
	.article-content :global(blockquote) { margin: 28px 0; padding: 16px 20px; border-left: 3px solid var(--color-accent); background: var(--color-bg-subtle); color: var(--color-text-secondary); }
	.article-content :global(img) { margin: 28px 0; border-radius: var(--radius-lg); }
	.article-content :global(hr) { margin: 40px 0; border: 0; border-top: 1px solid var(--color-border); }
	.article-content :global(code:not(pre code)) { padding: 2px 6px; border-radius: var(--radius); background: var(--inline-code-bg); color: var(--inline-code-fg); font-family: var(--font-mono); font-size: 0.88em; }
	.article-content :global(.emdash-code) { margin: 24px 0 28px; overflow: hidden; border: 1px solid var(--code-border); border-radius: var(--radius-lg); background: var(--code-bg); color: var(--code-fg); }
	.article-content :global(.emdash-code-filename) { padding: 8px 14px; border-bottom: 1px solid var(--code-border); border-radius: 0; background: var(--code-header); color: var(--code-fg); font-family: var(--font-mono); font-size: 0.75rem; }
	.article-content :global(.emdash-code pre) { margin: 0; padding: 16px; overflow-x: auto; border-radius: 0; background: var(--code-bg); font-family: var(--font-mono); font-size: 0.8438rem; line-height: 1.65; }
	.article-content :global(.emdash-code pre code) { padding: 0; border-radius: 0; background: transparent; color: var(--code-fg); font-family: var(--font-mono); font-size: inherit; }
	.sidebar-sticky { position: sticky; top: calc(var(--nav-height) + 26px); }
	.toc { margin-bottom: 28px; }
	.toc[hidden] { display: none; }
	.toc-title { margin-bottom: 12px; color: var(--color-muted); font-size: 0.75rem; letter-spacing: 0.08em; }
	#toc-content :global(.toc-list) { list-style: none; border-left: 2px solid var(--color-border); }
	#toc-content :global(.toc-item--nested) { padding-left: 10px; }
	#toc-content :global(.toc-link) { display: block; margin-left: -2px; padding: 6px 12px; border-left: 2px solid transparent; color: var(--color-muted); font-size: 0.8125rem; line-height: 1.5; }
	#toc-content :global(.toc-link:hover), #toc-content :global(.toc-link.active) { border-left-color: var(--color-accent); background: var(--color-accent-soft); color: var(--color-accent); }
	.sidebar-widgets :global(.widget-area) { display: flex; flex-direction: column; gap: 24px; }
	.sidebar-widgets :global(.widget__title) { margin-bottom: 10px; color: var(--color-muted); font-size: 0.75rem; }
	.sidebar-widgets :global(.widget__content) { color: var(--color-text-secondary); font-size: 0.8125rem; line-height: 1.8; }
	.sidebar-widgets :global(.widget-search) { display: flex; flex-direction: column; gap: 8px; }
	.sidebar-widgets :global(.widget-search__input) { width: 100%; padding: 8px 10px; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg); color: var(--color-text); font-family: var(--font-sans); font-size: 0.8125rem; }
	.sidebar-widgets :global(.widget-search__button) { display: none; }
	.sidebar-widgets :global(.widget-categories), .sidebar-widgets :global(.widget-recent-posts), .sidebar-widgets :global(.widget-archives), .sidebar-widgets :global(.widget-tags__cloud) { list-style: none; }
	.sidebar-widgets :global(.widget-categories li), .sidebar-widgets :global(.widget-recent-posts li), .sidebar-widgets :global(.widget-archives li) { padding: 6px 0; border-bottom: 1px solid var(--color-border); }
	.sidebar-widgets :global(.widget a) { color: var(--color-text-secondary); }
	.sidebar-widgets :global(.widget-tags__cloud) { display: flex; flex-wrap: wrap; gap: 6px; }
	.article-comments { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--color-border); }
	.article-comments :global(.ec-comments) { --ec-comment-border: 1px solid var(--color-border); }
	.article-comments :global(.ec-comments-heading) { margin-bottom: 32px; font-size: 1.5rem; }
	.article-comments :global(.ec-comment-author), .article-comments :global(.ec-comment-body) { color: var(--color-text); }
	.article-comments :global(.ec-comment-date) { color: var(--color-muted); font-family: var(--font-mono); }
	.article-comments :global(.ec-comment-form-field input), .article-comments :global(.ec-comment-form-field textarea), .article-comments :global(.ec-comment-user-info) { border-color: var(--color-border) !important; background: var(--color-bg-subtle) !important; color: var(--color-text) !important; }
	.article-comments :global(.ec-comment-form-submit) { background: var(--color-accent) !important; color: var(--color-on-accent) !important; }
	.more-posts { padding: 56px 0; background: var(--color-bg-subtle); }
	.more-inner { max-width: 900px; margin: 0 auto; padding: 0 24px; }
	.more-inner > h2 { margin-bottom: 16px; border-bottom: 1px solid var(--color-border); font-size: 1.375rem; }
	@media (max-width: 960px) {
		.article-layout { grid-template-columns: minmax(0, 1fr); }
		.article-sidebar { min-width: 0; }
		.sidebar-sticky { position: static; }
		.toc { display: none; }
		.sidebar-widgets :global(.widget-area) { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
	}
	@media (max-width: 680px) {
		.article-shell { padding: 28px 20px 56px; }
		.article-header-grid.has-image { grid-template-columns: minmax(0, 1fr); }
		.article-thumb { max-width: 320px; }
		.article-header h1 { font-size: 1.625rem; }
	}
</style>

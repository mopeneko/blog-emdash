---
import { getEmDashCollection, getEntryTerms } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { toPostCardProps } from "../../utils/post-presentation";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
Astro.cache.set(cacheHint);
const cards = await Promise.all(
	posts.map(async (post) => toPostCardProps(
		post.data,
		`/posts/${post.id}`,
		await getEntryTerms("posts", post.data.id, "tag"),
	)),
);
---

<Base title="すべての記事" description="公開済みのすべての記事">
	<section class="archive-section">
		<header class="archive-header">
			<p class="archive-label">ARCHIVE</p>
			<h1>すべての記事</h1>
			<p class="archive-count">{cards.length} 記事</p>
		</header>
		<div class="article-stream">
			{cards.length > 0
				? cards.map((card) => <PostCard {...card} />)
				: <p class="empty">まだ記事がありません。</p>}
		</div>
	</section>
</Base>

<style>
	.archive-section { max-width: 900px; margin: 0 auto; padding: 48px 24px 80px; }
	.archive-header { margin-bottom: 8px; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
	.archive-label { margin-bottom: 8px; color: var(--color-accent); font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; }
	.archive-header h1 { font-size: 1.875rem; }
	.archive-count { margin-top: 8px; color: var(--color-muted); font-size: 0.8125rem; }
	.empty { padding: 24px 0; color: var(--color-muted); }
	@media (max-width: 680px) { .archive-section { padding: 32px 20px 56px; } }
</style>

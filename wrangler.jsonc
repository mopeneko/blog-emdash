{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"account_id": "71395362d758c6c599d8ec54f35f98de",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "6edb8f743fbf4942bf99aaa25b4babc4"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site",
			"database_id": "53c96d01-8a01-40fa-8dd4-d630163ed15b"
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"routes": [
		{
			"pattern": "blog.lem0n.cc",
			"custom_domain": true
		}
	],
	"observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

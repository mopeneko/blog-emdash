{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site",
			"database_id": "53c96d01-8a01-40fa-8dd4-d630163ed15b"
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"routes": [
		{
			"pattern": "blog.lem0n.cc",
			"custom_domain": true
		}
	],
	"observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
